CUDA_VISIBLE_DEVICES=0

# Redis (Local: localhost, Docker: redis)
# Docker: docker-compose --profile gpu-only up -d
REDIS_HOST=localhost
REDIS_PORT=6379

# Internal callback
BACKEND_INTERNAL_BASE_URL=http://host.docker.internal:8080
WORKER_SECRET=replace_with_strong_worker_secret
CALLBACK_STRICT=false
CALLBACK_RETRY_COUNT=3
CALLBACK_RETRY_DELAY_SECONDS=1.0

# Backend Redis queue consumer
BACKEND_JOB_QUEUE_KEY=job-queue
BACKEND_JOB_QUEUE_BLOCK_TIMEOUT_SECONDS=5
BACKEND_JOB_QUEUE_RETRY_DELAY_SECONDS=3.0

# Default runtime options for backend-created worker jobs
AI_DEFAULT_MODEL=small
AI_DEFAULT_BATCH_SIZE=2
AI_DEFAULT_COMPUTE_TYPE=int8_float16
AI_DEFAULT_NO_ALIGN=false
AI_STT_MIN_SEGMENT_SECONDS=0.2
AI_STT_MAX_SEGMENT_SECONDS=7.0
AI_STT_MAX_SEGMENT_CHARS=90
AI_STT_MIN_SPLIT_SECONDS=1.0
AI_STT_TIME_OFFSET_SECONDS=0.0
AI_DEFAULT_FRAME_INTERVAL=0.5
AI_DEFAULT_OCR_GPU=true
AI_OCR_REGIONS=full,top,center,bottom
AI_OCR_CHANGE_THRESHOLD=0.015
AI_OCR_SKIP_UNCHANGED_FRAMES=true
AI_OCR_MAX_SKIP_FRAMES=1
AI_OCR_MIN_CONFIDENCE=0.3
AI_OCR_MIN_TEXT_LENGTH=2
AI_OCR_MAX_SPECIAL_CHAR_RATIO=0.6
AI_OCR_EDGE_MARGIN=0.0
AI_OCR_BBOX_CHANGE_THRESHOLD=0.01
AI_OCR_BBOX_CHANGE_PADDING=0.02
AI_OCR_REFINE_ENABLED=true
AI_OCR_REFINE_SCALE=2.0
AI_OCR_REFINE_PADDING=0.015
AI_OCR_REFINE_MIN_CONFIDENCE=0.2

# Translation (OPENAI provider)
OPENAI_API_KEY=your_openai_api_key
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
OPENAI_TRANSLATION_BATCH_SIZE=5
OPENAI_REQUEST_TIMEOUT_SECONDS=180
OPENAI_LEARNING_MODEL=gpt-5.4-mini
OPENAI_LEARNING_MAX_SEGMENTS=40
OPENAI_LEARNING_MAX_CONTENTS=10
